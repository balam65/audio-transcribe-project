# ============================================
# Meeting Transcription System — Configuration
# Configurable transcription + configurable summaries
# ============================================

# --- App Mode / Authentication ---
# desktop = full local experience
# hosted = public deployment (uploaded-file transcription only)
APP_MODE=desktop

# In hosted mode, set backend-enforced credentials.
AUTH_REQUIRED=false
AUTH_USERNAME=admin
AUTH_PASSWORD=
SESSION_SECRET=
PUBLIC_BASE_URL=

# --- Transcription Engine ---
# Use `openai` for OpenAI or any OpenAI-compatible speech-to-text API.
# Use `faster-whisper` to keep transcription fully local.
TRANSCRIBE_ENGINE=openai

# OpenAI-compatible transcription model
# Use the mini transcription model when you want the GPT-4o mini family.
OPENAI_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe

# Uploaded files are chunked to preserve timeline segments in the UI.
OPENAI_TRANSCRIPTION_CHUNK_SECONDS=20
OPENAI_TRANSCRIPTION_MAX_RETRIES=2
OPENAI_TRANSCRIPT_POLISH=true
OPENAI_TRANSCRIPT_POLISH_MIN_CHARS=600

# Keep mixed-language meetings in normal English output.
OPENAI_TRANSCRIPTION_PROMPT=Transcribe the speech clearly and accurately. If speakers use multiple languages, translate everything into natural English. Preserve names, numbers, technical terms, and meaning exactly. Do not summarize, shorten, or omit spoken details.

# Whisper model: tiny, base, small, medium, large-v3
# large-v3 = highest accuracy (requires ~3GB RAM)
# medium = good balance if large-v3 is too slow
WHISPER_MODEL=large-v3

# Task: "translate" outputs English regardless of input language
# Use "transcribe" to keep the original language
WHISPER_TASK=translate

# Output language (only used when task=transcribe)
WHISPER_OUTPUT_LANGUAGE=en

# Device: auto, cpu, cuda
# "auto" detects GPU automatically
WHISPER_DEVICE=auto

# Compute type: auto, float16, int8, int8_float16, float32
# "auto" uses float16 on GPU, int8 on CPU
WHISPER_COMPUTE_TYPE=auto

# --- Audio Settings ---
AUDIO_CHUNK_SECONDS=6
AUDIO_CHUNK_STEP_SECONDS=3
LIVE_NORMALIZE_NON_ENGLISH_ONLY=true

# --- Speaker Diarization ---
ENABLE_DIARIZATION=false

# --- Summary Engine ---
# Use `openai` for OpenAI or any OpenAI-compatible router/base URL.
# Use `ollama` to keep summaries fully local.
SUMMARY_ENGINE=openai

# Reliable OpenRouter summary default
SUMMARY_MODEL=openai/gpt-4o-mini

# OpenAI / OpenAI-compatible provider settings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
# For direct OpenAI instead, use: https://api.openai.com/v1
OPENAI_PROJECT=
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=120

# Ollama settings (only used when SUMMARY_ENGINE=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- Anti-Hallucination ---
CONFIDENCE_THRESHOLD=0.4
NO_SPEECH_THRESHOLD=0.6

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Storage ---
DATABASE_PATH=data/meetings.db
EXPORT_DIR=data/exports
LOCAL_RECORDING_DIR=data/local_recordings
